{
    "name": "maw-photos",
    "version": "4.2.0",
    "description": "Interactive application to view photos",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --mode dev",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build --mode production",
        "serve": "vite preview",
        "test": "vitest",
        "build_staging": "tsc --noEmit && vite build --mode staging",
        "format": "prettier --write --cache .",
        "format:check": "prettier --check --cache ."
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@iconify-json/ic": "^1.2.4",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@solidjs/testing-library": "^0.8.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.101.4",
        "@tanstack/solid-query-devtools": "^5.101.4",
        "@types/google.maps": "^3.65.3",
        "@types/node": "^24.13.3",
        "daisyui": "^5.7.4",
        "eslint": "^9.39.5",
        "eslint-plugin-solid": "^0.14.5",
        "globals": "^17.7.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vite-plugin-solid": "^2.11.13",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@auth0/auth0-spa-js": "^2.24.0",
        "@solid-primitives/keyboard": "^1.3.7",
        "@solid-primitives/media": "^2.3.6",
        "@solid-primitives/resize-observer": "^2.2.0",
        "@solidjs/router": "^0.16.2",
        "@tanstack/solid-query": "^5.101.4",
        "date-fns": "^4.4.0",
        "highcharts": "^13.0.0",
        "numbro": "^2.5.0",
        "solid-js": "^1.9.14"
    }
}
