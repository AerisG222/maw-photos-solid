{
    "name": "maw-photos",
    "version": "5.0.0",
    "description": "Interactive application to view photos",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --mode dev",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build --mode production",
        "serve": "vite preview",
        "test": "vitest",
        "build_staging": "tsc --noEmit && vite build --mode staging",
        "format": "prettier --write --cache .",
        "format:check": "prettier --check --cache ."
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify-json/ic": "^1.2.4",
        "@iconify/tailwind4": "^1.2.3",
        "@solidjs/testing-library": "^0.8.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.104.0",
        "@tanstack/solid-query-devtools": "^5.104.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@types/google.maps": "^3.66.4",
        "@types/node": "^26.6.3",
        "daisyui": "^5.7.46",
        "eslint": "^10.11.0",
        "eslint-plugin-solid": "^0.18.0",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^5.0.2"
    },
    "dependencies": {
        "@auth0/auth0-spa-js": "^2.27.0",
        "@fontsource-variable/nunito-sans": "^5.3.0",
        "@fontsource/tangerine": "^5.3.0",
        "@kobalte/core": "^0.13.14",
        "@panzoom/panzoom": "^4.6.2",
        "@solid-primitives/keyboard": "^1.3.7",
        "@solid-primitives/media": "^2.3.6",
        "@solid-primitives/resize-observer": "^2.2.0",
        "@solidjs/router": "^1.0.0",
        "@tanstack/solid-query": "^5.104.0",
        "@tanstack/solid-virtual": "^3.13.40",
        "date-fns": "^4.4.0",
        "highcharts": "^13.1.1",
        "solid-js": "^1.9.15"
    }
}
