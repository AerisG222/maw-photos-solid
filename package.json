{
    "name": "maw-photos",
    "version": "4.5.0",
    "description": "Interactive application to view photos",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --mode dev",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build --mode production",
        "serve": "vite preview",
        "test": "vitest",
        "build_staging": "tsc --noEmit && vite build --mode staging",
        "format": "prettier --write --cache .",
        "format:check": "prettier --check --cache ."
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify-json/ic": "^1.2.4",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@solidjs/testing-library": "^0.8.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.102.8",
        "@tanstack/solid-query-devtools": "^5.102.8",
        "@types/google.maps": "^3.66.2",
        "@types/node": "^26.4.1",
        "daisyui": "^5.7.28",
        "eslint": "^10.9.1",
        "eslint-plugin-solid": "^0.17.0",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@auth0/auth0-spa-js": "^2.24.1",
        "@solid-primitives/keyboard": "^1.3.7",
        "@solid-primitives/media": "^2.3.6",
        "@solid-primitives/resize-observer": "^2.2.0",
        "@solidjs/router": "^1.0.0",
        "@tanstack/solid-query": "^5.102.8",
        "date-fns": "^4.4.0",
        "highcharts": "^13.0.2",
        "numbro": "^2.5.0",
        "solid-js": "^1.9.15"
    }
}
