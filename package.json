{
    "name": "maw-photos",
    "version": "4.0.2",
    "description": "Interactive application to view photos",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --mode dev",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build --mode production",
        "serve": "vite preview",
        "test": "vitest",
        "build_staging": "tsc --noEmit && vite build --mode staging",
        "format": "prettier --write --cache \"**/*.[tj]s?(x)\""
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@iconify-json/ic": "^1.2.4",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@solidjs/testing-library": "^0.8.10",
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/eslint-plugin-query": "^5.101.2",
        "@tanstack/solid-query-devtools": "^5.101.2",
        "@types/google.maps": "^3.65.2",
        "daisyui": "^5.6.13",
        "eslint": "^9.39.4",
        "eslint-plugin-solid": "^0.14.5",
        "globals": "^17.7.0",
        "prettier": "^3.9.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vite": "^8.1.3",
        "vite-plugin-solid": "^2.11.12",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "@auth0/auth0-spa-js": "^2.22.0",
        "@solid-primitives/keyboard": "^1.3.7",
        "@solid-primitives/media": "^2.3.6",
        "@solid-primitives/resize-observer": "^2.1.6",
        "@solidjs/router": "^0.16.1",
        "@tanstack/solid-query": "^5.101.2",
        "date-fns": "^4.4.0",
        "highcharts": "^13.0.0",
        "numbro": "^2.5.0",
        "solid-js": "^1.9.14"
    }
}
